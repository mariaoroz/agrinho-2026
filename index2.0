<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AgroVision 2030 — Uma Viagem Pelas Décadas</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #07111f;
            --card-bg: rgba(255, 255, 255, 0.04);
            --border: rgba(255, 255, 255, 0.08);
            --accent: #38bdf8;
            --accent2: #0ea5e9;
            --text: #e5e7eb;
            --subtext: #94a3b8;
            --hero-overlay: rgba(5, 10, 20, 0.75);
            --nav-bg: rgba(8, 15, 30, 0.9);
            --stat-bg: linear-gradient(135deg, #0f172a, #111827);
            --banner-bg: linear-gradient(135deg, #0f172a, #1e3a8a);
            --btn-bg: linear-gradient(135deg, #0ea5e9, #2563eb);
            --font-main: 'Montserrat', sans-serif;
            --font-mono: 'Space Mono', monospace;
            --timeline-line: #38bdf8;
            --glow: rgba(56, 189, 248, 0.35);
        }

        /* Temas por década */
        body.decade-1970 {
            --bg: #1a1307;
            --accent: #f59e0b;
            --accent2: #d97706;
            --hero-overlay: rgba(20, 15, 5, 0.8);
            --nav-bg: rgba(30, 20, 8, 0.9);
            --stat-bg: linear-gradient(135deg, #2d1f0a, #3a2c10);
            --banner-bg: linear-gradient(135deg, #3a2c10, #92400e);
            --btn-bg: linear-gradient(135deg, #f59e0b, #b45309);
            --timeline-line: #f59e0b;
            --glow: rgba(245, 158, 11, 0.4);
            --border: rgba(255, 255, 255, 0.1);
            --card-bg: rgba(255, 255, 255, 0.06);
        }

        body.decade-1980 {
            --bg: #0d0a1a;
            --accent: #ec4899;
            --accent2: #be185d;
            --hero-overlay: rgba(10, 5, 20, 0.8);
            --nav-bg: rgba(20, 10, 30, 0.9);
            --stat-bg: linear-gradient(135deg, #1a0f2e, #2d1040);
            --banner-bg: linear-gradient(135deg, #2d1040, #831843);
            --btn-bg: linear-gradient(135deg, #ec4899, #9d174d);
            --timeline-line: #ec4899;
            --glow: rgba(236, 72, 153, 0.4);
            --border: rgba(255, 255, 255, 0.12);
            --card-bg: rgba(255, 255, 255, 0.06);
        }

        body.decade-1990 {
            --bg: #0a1a0a;
            --accent: #10b981;
            --accent2: #047857;
            --hero-overlay: rgba(5, 15, 5, 0.8);
            --nav-bg: rgba(10, 20, 10, 0.9);
            --stat-bg: linear-gradient(135deg, #0a2a0a, #0f3a0f);
            --banner-bg: linear-gradient(135deg, #0f3a0f, #065f46);
            --btn-bg: linear-gradient(135deg, #10b981, #065f46);
            --timeline-line: #10b981;
            --glow: rgba(16, 185, 129, 0.4);
            --border: rgba(255, 255, 255, 0.1);
            --card-bg: rgba(255, 255, 255, 0.06);
        }

        body.decade-2000 {
            --bg: #0f172a;
            --accent: #8b5cf6;
            --accent2: #6d28d9;
            --hero-overlay: rgba(5, 10, 25, 0.8);
            --nav-bg: rgba(15, 20, 35, 0.9);
            --stat-bg: linear-gradient(135deg, #1e1b4b, #2e1065);
            --banner-bg: linear-gradient(135deg, #2e1065, #4c1d95);
            --btn-bg: linear-gradient(135deg, #8b5cf6, #5b21b6);
            --timeline-line: #8b5cf6;
            --glow: rgba(139, 92, 246, 0.4);
            --border: rgba(255, 255, 255, 0.1);
            --card-bg: rgba(255, 255, 255, 0.05);
        }

        body.decade-2030 {
            --bg: #07111f;
            --accent: #38bdf8;
            --accent2: #0ea5e9;
            --hero-overlay: rgba(5, 10, 20, 0.75);
            --nav-bg: rgba(8, 15, 30, 0.9);
            --stat-bg: linear-gradient(135deg, #0f172a, #111827);
            --banner-bg: linear-gradient(135deg, #0f172a, #1e3a8a);
            --btn-bg: linear-gradient(135deg, #0ea5e9, #2563eb);
            --timeline-line: #38bdf8;
            --glow: rgba(56, 189, 248, 0.35);
            --border: rgba(255, 255, 255, 0.08);
            --card-bg: rgba(255, 255, 255, 0.04);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--font-main);
            background: var(--bg);
            color: var(--text);
            overflow-x: hidden;
            transition: background 0.5s ease, color 0.5s ease;
        }

        /* Scrollbar estilizada */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--accent);
            border-radius: 10px;
        }

        /* Header com parallax simples */
        header {
            height: 100vh;
            background:
                linear-gradient(var(--hero-overlay), var(--hero-overlay)),
                url('https://images.unsplash.com/photo-1500382017468-9049fed747ef?q=80&w=1600&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

        /* Efeito de partículas simples (apenas visual) */
        .particles {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }
        .particle {
            position: absolute;
            background: var(--accent);
            border-radius: 50%;
            opacity: 0.3;
            animation: floatUp 8s infinite ease-in;
        }
        @keyframes floatUp {
            0% {
                transform: translateY(100vh) scale(0);
                opacity: 0;
            }
            10% {
                opacity: 0.6;
            }
            90% {
                opacity: 0.1;
            }
            100% {
                transform: translateY(-10vh) scale(1.5);
                opacity: 0;
            }
        }

        .hero {
            position: relative;
            z-index: 2;
            animation: fadeInDown 1.2s ease-out;
        }
        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-40px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .hero h1 {
            font-size: 5rem;
            font-weight: 800;
            color: white;
            margin-bottom: 20px;
            text-shadow: 0 0 30px var(--glow);
            font-family: var(--font-mono);
            letter-spacing: -2px;
        }

        .hero h2 {
            font-size: 2rem;
            color: var(--accent);
            margin-bottom: 25px;
            font-weight: 600;
        }

        .hero p {
            max-width: 850px;
            margin: auto;
            font-size: 1.2rem;
            color: #cbd5e1;
            margin-bottom: 40px;
            line-height: 1.6;
        }

        .btn {
            display: inline-block;
            padding: 16px 40px;
            border-radius: 50px;
            text-decoration: none;
            background: var(--btn-bg);
            color: white;
            font-weight: 700;
            transition: 0.4s;
            box-shadow: 0 10px 30px var(--glow);
            cursor: pointer;
            border: none;
            font-family: var(--font-main);
            font-size: 1rem;
        }
        .btn:hover {
            transform: translateY(-5px) scale(1.03);
            filter: brightness(1.1);
        }

        /* Seletor de década */
        .decade-selector {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1001;
            display: flex;
            gap: 8px;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(12px);
            padding: 8px 12px;
            border-radius: 40px;
            border: 1px solid var(--border);
            flex-wrap: wrap;
            justify-content: center;
        }
        .decade-dot {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            cursor: pointer;
            transition: 0.3s;
            border: 2px solid transparent;
            font-size: 0.7rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            background: #333;
            position: relative;
        }
        .decade-dot.active {
            border-color: var(--accent);
            box-shadow: 0 0 15px var(--glow);
            transform: scale(1.15);
        }
        .decade-dot:hover {
            transform: scale(1.1);
            border-color: var(--accent);
        }
        .decade-dot[data-decade="1970"] {
            background: #b45309;
        }
        .decade-dot[data-decade="1980"] {
            background: #9d174d;
        }
        .decade-dot[data-decade="1990"] {
            background: #047857;
        }
        .decade-dot[data-decade="2000"] {
            background: #6d28d9;
        }
        .decade-dot[data-decade="2030"] {
            background: #2563eb;
        }
        .decade-label {
            position: absolute;
            top: -25px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.65rem;
            white-space: nowrap;
            color: white;
            opacity: 0;
            transition: 0.3s;
            pointer-events: none;
        }
        .decade-dot:hover .decade-label {
            opacity: 1;
            top: -28px;
        }

        nav {
            position: sticky;
            top: 0;
            z-index: 999;
            background: var(--nav-bg);
            backdrop-filter: blur(10px);
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            padding: 18px;
            border-bottom: 1px solid var(--border);
            transition: background 0.5s ease;
        }
        nav a {
            color: #e2e8f0;
            text-decoration: none;
            margin: 8px 18px;
            font-weight: 600;
            transition: 0.3s;
            position: relative;
        }
        nav a::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0%;
            height: 2px;
            background: var(--accent);
            transition: 0.3s;
        }
        nav a:hover {
            color: var(--accent);
        }
        nav a:hover::after {
            width: 100%;
        }

        section {
            padding: 100px 10%;
        }

        .title {
            text-align: center;
            margin-bottom: 70px;
        }
        .title h2 {
            font-size: 3rem;
            margin-bottom: 20px;
            color: var(--accent);
        }
        .title p {
            max-width: 800px;
            margin: auto;
            color: var(--subtext);
            font-size: 1.1rem;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 28px;
            overflow: hidden;
            transition: 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            backdrop-filter: blur(10px);
            cursor: pointer;
            transform-style: preserve-3d;
            perspective: 1000px;
        }
        .card:hover {
            transform: translateY(-10px) rotateX(2deg) rotateY(-2deg);
            border-color: var(--accent);
            box-shadow: 0 20px 40px var(--glow);
        }
        .card img {
            width: 100%;
            height: 240px;
            object-fit: cover;
            transition: 0.5s;
        }
        .card:hover img {
            transform: scale(1.05);
        }
        .card-content {
            padding: 30px;
        }
        .card-content h3 {
            margin-bottom: 15px;
            color: var(--accent);
        }
        .card-content p {
            color: #cbd5e1;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 25px;
            margin-top: 60px;
        }
        .stat {
            background: var(--stat-bg);
            border: 1px solid var(--border);
            border-radius: 25px;
            text-align: center;
            padding: 45px;
            transition: 0.4s;
        }
        .stat:hover {
            border-color: var(--accent);
            box-shadow: 0 10px 25px var(--glow);
            transform: translateY(-5px);
        }
        .stat h3 {
            font-size: 3.5rem;
            color: var(--accent);
            margin-bottom: 15px;
            font-family: var(--font-mono);
        }

        .tech-banner {
            background: var(--banner-bg);
            border-radius: 35px;
            padding: 80px;
            text-align: center;
            border: 1px solid var(--border);
            transition: 0.5s;
        }
        .tech-banner h2 {
            font-size: 3rem;
            margin-bottom: 25px;
        }
        .tech-banner p {
            max-width: 850px;
            margin: auto;
            margin-bottom: 35px;
            color: #dbeafe;
        }

        .video iframe {
            width: 100%;
            height: 550px;
            border: none;
            border-radius: 25px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
        }

        /* Linha do tempo interativa */
        .timeline-interactive {
            display: flex;
            flex-direction: column;
            gap: 20px;
            position: relative;
            padding-left: 40px;
        }
        .timeline-interactive::before {
            content: '';
            position: absolute;
            left: 18px;
            top: 0;
            bottom: 0;
            width: 4px;
            background: var(--timeline-line);
            border-radius: 2px;
            box-shadow: 0 0 15px var(--glow);
        }
        .timeline-item {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 25px 30px;
            position: relative;
            transition: 0.4s;
            cursor: pointer;
            margin-left: 20px;
        }
        .timeline-item:hover {
            border-color: var(--accent);
            box-shadow: 0 0 25px var(--glow);
            transform: translateX(8px);
        }
        .timeline-item::before {
            content: '';
            position: absolute;
            left: -38px;
            top: 28px;
            width: 16px;
            height: 16px;
            background: var(--accent);
            border-radius: 50%;
            border: 3px solid var(--bg);
            box-shadow: 0 0 10px var(--glow);
        }
        .timeline-year {
            font-family: var(--font-mono);
            font-size: 1.8rem;
            color: var(--accent);
            font-weight: 700;
            margin-bottom: 8px;
        }
        .timeline-desc {
            color: #cbd5e1;
        }

        /* Quiz */
        .quiz-container {
            margin-top: 50px;
            background: var(--card-bg);
            border-radius: 25px;
            padding: 45px;
            text-align: center;
            border: 1px solid var(--border);
        }
        .quiz-question {
            font-size: 1.3rem;
            margin-bottom: 25px;
            color: white;
        }
        .quiz-options {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            max-width: 600px;
            margin: auto;
        }
        .quiz-option {
            padding: 15px;
            border-radius: 15px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border);
            cursor: pointer;
            transition: 0.3s;
            color: #e2e8f0;
            font-weight: 500;
        }
        .quiz-option:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: var(--accent);
        }
        .quiz-option.correct {
            background: #10b981 !important;
            border-color: #10b981 !important;
            color: white !important;
        }
        .quiz-option.wrong {
            background: #ef4444 !important;
            border-color: #ef4444 !important;
            color: white !important;
        }
        .quiz-feedback {
            margin-top: 20px;
            font-weight: 600;
            min-height: 24px;
        }

        form {
            max-width: 750px;
            margin: auto;
            background: var(--card-bg);
            border-radius: 25px;
            padding: 45px;
            border: 1px solid var(--border);
        }
        input,
        textarea {
            width: 100%;
            padding: 16px;
            margin-top: 10px;
            margin-bottom: 25px;
            border: 1px solid var(--border);
            border-radius: 14px;
            background: #0f172a;
            color: white;
            font-family: var(--font-main);
            transition: 0.3s;
        }
        input:focus,
        textarea:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 15px var(--glow);
        }

        footer {
            background: #020617;
            padding: 60px 10%;
            margin-top: 80px;
            border-top: 1px solid var(--border);
        }
        .footer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 40px;
        }
        .footer-grid h3 {
            color: var(--accent);
            margin-bottom: 15px;
        }
        .footer-grid p,
        .footer-grid a {
            color: #94a3b8;
            text-decoration: none;
            display: block;
            margin-bottom: 10px;
            transition: 0.3s;
        }
        .footer-grid a:hover {
            color: var(--accent);
        }
        .copy {
            margin-top: 40px;
            text-align: center;
            color: #64748b;
        }

        /* Botão voltar ao topo */
        .back-to-top {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 50px;
            height: 50px;
            background: var(--btn-bg);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
            cursor: pointer;
            z-index: 1000;
            opacity: 0;
            transform: translateY(20px);
            transition: 0.4s;
            box-shadow: 0 8px 25px var(--glow);
            border: none;
        }
        .back-to-top.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Animações de entrada */
        .fade {
            opacity: 0;
            transform: translateY(40px);
            transition: 0.8s ease-out;
        }
        .fade.show {
            opacity: 1;
            transform: translateY(0);
        }

        @media (max-width: 900px) {
            .hero h1 {
                font-size: 2.8rem;
            }
            .hero h2 {
                font-size: 1.3rem;
            }
            .video iframe {
                height: 250px;
            }
            .tech-banner {
                padding: 50px 20px;
            }
            .quiz-options {
                grid-template-columns: 1fr;
            }
            .decade-selector {
                top: auto;
                bottom: 15px;
                right: 15px;
                padding: 6px 10px;
                gap: 5px;
            }
            .decade-dot {
                width: 28px;
                height: 28px;
                font-size: 0.6rem;
            }
        }
    </style>
</head>
<body class="decade-2030">

    <!-- Seletor de década flutuante -->
    <div class="decade-selector" aria-label="Seletor de década">
        <div class="decade-dot active" data-decade="1970" title="Anos 70">70<span class="decade-label">1970</span></div>
        <div class="decade-dot" data-decade="1980" title="Anos 80">80<span class="decade-label">1980</span></div>
        <div class="decade-dot" data-decade="1990" title="Anos 90">90<span class="decade-label">1990</span></div>
        <div class="decade-dot" data-decade="2000" title="Anos 2000">00<span class="decade-label">2000</span></div>
        <div class="decade-dot active" data-decade="2030" title="2030">30<span class="decade-label">2030</span></div>
    </div>

    <!-- Header -->
    <header>
        <div class="particles" id="particles"></div>
        <div class="hero">
            <h1>AgroVision 2030</h1>
            <h2>Uma Viagem Pelas Décadas da Inovação no Campo</h2>
            <p>
                Da mecanização dos anos 70 à inteligência artificial de 2030: descubra como a tecnologia transformou o agronegócio brasileiro.
            </p>
            <a href="#linha-do-tempo" class="btn">Explorar Linha do Tempo</a>
        </div>
    </header>

    <!-- Navegação -->
    <nav>
        <a href="#producao">Produção</a>
        <a href="#tecnologia">Tecnologia</a>
        <a href="#linha-do-tempo">Linha do Tempo</a>
        <a href="#sustentabilidade">Sustentabilidade</a>
        <a href="#quiz-section">Quiz</a>
        <a href="#contato">Contato</a>
    </nav>

    <!-- Seção Produção -->
    <section id="producao" class="fade">
        <div class="title">
            <h2>O Agro Move o Brasil</h2>
            <p>O agronegócio representa inovação, produtividade e desenvolvimento econômico para milhões de pessoas.</p>
        </div>
        <div class="grid">
            <div class="card">
                <img src="https://images.unsplash.com/photo-1464226184884-fa280b87c399?q=80&w=1200&auto=format&fit=crop" alt="Produção Inteligente">
                <div class="card-content">
                    <h3>Produção Inteligente</h3>
                    <p>Tecnologias modernas aumentam a eficiência agrícola.</p>
                </div>
            </div>
            <div class="card">
                <img src="https://images.unsplash.com/photo-1509391366360-2e959784a276?q=80&w=1200&auto=format&fit=crop" alt="Energia Limpa">
                <div class="card-content">
                    <h3>Energia Limpa</h3>
                    <p>Fazendas sustentáveis utilizam energia renovável.</p>
                </div>
            </div>
            <div class="card">
                <img src="https://images.unsplash.com/photo-1492496913980-501348b61469?q=80&w=1200&auto=format&fit=crop" alt="Preservação Ambiental">
                <div class="card-content">
                    <h3>Preservação Ambiental</h3>
                    <p>O futuro depende do equilíbrio entre produção e natureza.</p>
                </div>
            </div>
        </div>
        <div class="stats">
            <div class="stat">
                <h3 class="counter" data-target="27">0</h3>
                <p>Participação do agro no PIB brasileiro (%)</p>
            </div>
            <div class="stat">
                <h3 class="counter" data-target="70">0</h3>
                <p>Crescimento tecnológico no campo (%)</p>
            </div>
            <div class="stat">
                <h3 class="counter" data-target="2030">0</h3>
                <p>Meta para agricultura sustentável inteligente</p>
            </div>
        </div>
    </section>

    <!-- Seção Tecnologia -->
    <section id="tecnologia" class="fade">
        <div class="title">
            <h2>Tecnologia no Campo</h2>
            <p>A agricultura do futuro será conectada, automatizada e sustentável.</p>
        </div>
        <div class="grid">
            <div class="card">
                <img src="https://images.unsplash.com/photo-1523741543316-beb7fc7023d8?q=80&w=1200&auto=format&fit=crop" alt="Drones Agrícolas">
                <div class="card-content">
                    <h3>Drones Agrícolas</h3>
                    <p>Monitoramento inteligente das plantações.</p>
                </div>
            </div>
            <div class="card">
                <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=1200&auto=format&fit=crop" alt="Inteligência Artificial">
                <div class="card-content">
                    <h3>Inteligência Artificial</h3>
                    <p>IA aplicada à análise do solo e produção.</p>
                </div>
            </div>
            <div class="card">
                <img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?q=80&w=1200&auto=format&fit=crop" alt="GPS de Precisão">
                <div class="card-content">
                    <h3>GPS de Precisão</h3>
                    <p>Maior produtividade com menos desperdício.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Linha do Tempo Interativa -->
    <section id="linha-do-tempo" class="fade">
        <div class="title">
            <h2>Evolução da Agricultura</h2>
            <p>Clique em cada década para ver como a tecnologia revolucionou o campo.</p>
        </div>
        <div class="timeline-interactive">
            <div class="timeline-item" data-year="1970">
                <div class="timeline-year">1970</div>
                <div class="timeline-desc"><strong>Mecanização:</strong> Tratores e colheitadeiras começam a substituir a força animal, aumentando a produtividade.</div>
            </div>
            <div class="timeline-item" data-year="1980">
                <div class="timeline-year">1980</div>
                <div class="timeline-desc"><strong>Revolução Verde:</strong> Sementes melhoradas e fertilizantes químicos impulsionam safras recordes.</div>
            </div>
            <div class="timeline-item" data-year="1990">
                <div class="timeline-year">1990</div>
                <div class="timeline-desc"><strong>GPS e Precisão:</strong> As primeiras tecnologias de posicionamento chegam ao campo, otimizando o plantio.</div>
            </div>
            <div class="timeline-item" data-year="2000">
                <div class="timeline-year">2000</div>
                <div class="timeline-desc"><strong>Digitalização:</strong> Softwares de gestão e internet rural conectam fazendas ao mundo.</div>
            </div>
            <div class="timeline-item" data-year="2010">
                <div class="timeline-year">2010</div>
                <div class="timeline-desc"><strong>Drones e IoT:</strong> Monitoramento aéreo e sensores inteligentes transformam a tomada de decisão.</div>
            </div>
            <div class="timeline-item" data-year="2020">
                <div class="timeline-year">2020</div>
                <div class="timeline-desc"><strong>Inteligência Artificial:</strong> Algoritmos preditivos analisam clima, solo e mercado em tempo real.</div>
            </div>
            <div class="timeline-item" data-year="2030">
                <div class="timeline-year">2030</div>
                <div class="timeline-desc"><strong>Agro 5.0:</strong> Fazendas autônomas, robótica avançada e sustentabilidade total — o futuro é agora.</div>
            </div>
        </div>
    </section>

    <!-- Sustentabilidade -->
    <section id="sustentabilidade" class="fade">
        <div class="tech-banner">
            <h2>Produzir Sem Destruir</h2>
            <p>O uso consciente dos recursos naturais é essencial para garantir alimento, desenvolvimento e equilíbrio ambiental.</p>
            <a href="#quiz-section" class="btn">Testar Conhecimentos</a>
        </div>
    </section>

    <!-- Quiz Interativo -->
    <section id="quiz-section" class="fade">
        <div class="title">
            <h2>Quiz das Décadas</h2>
            <p>Será que você conhece a história da tecnologia no campo?</p>
        </div>
        <div class="quiz-container">
            <div class="quiz-question" id="questionText">Em qual década os drones começaram a ser usados na agricultura?</div>
            <div class="quiz-options" id="optionsContainer">
                <div class="quiz-option" data-correct="false">1970</div>
                <div class="quiz-option" data-correct="false">1990</div>
                <div class="quiz-option" data-correct="true">2010</div>
                <div class="quiz-option" data-correct="false">2030</div>
            </div>
            <div class="quiz-feedback" id="quizFeedback"></div>
            <button class="btn" id="nextQuizBtn" style="display:none; margin-top:20px;">Próxima Pergunta</button>
        </div>
    </section>

    <!-- Contato -->
    <section id="contato" class="fade">
        <div class="title">
            <h2>Fale Conosco</h2>
            <p>Compartilhe suas ideias sobre o futuro do agro.</p>
        </div>
        <form id="contactForm">
            <input type="text" placeholder="Seu nome" required>
            <input type="email" placeholder="Seu e-mail" required>
            <textarea rows="5" placeholder="Sua mensagem..."></textarea>
            <button type="submit" class="btn" style="width:100%;">Enviar Mensagem</button>
        </form>
    </section>

    <!-- Footer -->
    <footer>
        <div class="footer-grid">
            <div>
                <h3>AgroVision 2030</h3>
                <p>Tecnologia e sustentabilidade no campo.</p>
            </div>
            <div>
                <h3>Links</h3>
                <a href="#producao">Produção</a>
                <a href="#tecnologia">Tecnologia</a>
                <a href="#linha-do-tempo">Linha do Tempo</a>
            </div>
            <div>
                <h3>Contato</h3>
                <p>contato@agrovision2030.com.br</p>
                <p>+55 (11) 99999-9999</p>
            </div>
        </div>
        <div class="copy">© 2025 AgroVision 2030. Todos os direitos reservados.</div>
    </footer>

    <!-- Botão voltar ao topo -->
    <button class="back-to-top" id="backToTop" aria-label="Voltar ao topo">↑</button>

    <script>
        (function() {
            // === SELETOR DE DÉCADA ===
            const body = document.body;
            const decadeDots = document.querySelectorAll('.decade-dot');
            let currentDecade = '2030';

            function setDecade(decade) {
                body.className = body.className.replace(/decade-\d+/g, '');
                body.classList.add('decade-' + decade);
                decadeDots.forEach(d => d.classList.remove('active'));
                const activeDot = document.querySelector(`.decade-dot[data-decade="${decade}"]`);
                if (activeDot) activeDot.classList.add('active');
                currentDecade = decade;
                localStorage.setItem('agrovision-decade', decade);
            }

            decadeDots.forEach(dot => {
                dot.addEventListener('click', () => {
                    setDecade(dot.dataset.decade);
                });
            });

            // Recuperar preferência
            const savedDecade = localStorage.getItem('agrovision-decade');
            if (savedDecade) setDecade(savedDecade);
            else setDecade('2030');

            // === LINHA DO TEMPO: clique muda década ===
            document.querySelectorAll('.timeline-item').forEach(item => {
                item.addEventListener('click', () => {
                    const year = item.dataset.year;
                    if (year) {
                        setDecade(year);
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }
                });
            });

            // === QUIZ INTERATIVO ===
            const quizData = [
                { question: 'Em qual década os drones começaram a ser usados na agricultura?', options: [
                        '1970', '1990', '2010', '2030'], correct: 2 },
                { question: 'Qual tecnologia marcou os anos 90 no campo?', options: ['Inteligência Artificial',
                        'GPS de precisão', 'Drones', 'Robótica'], correct: 1 },
                { question: 'O que caracteriza o Agro 5.0 em 2030?', options: ['Uso de tração animal',
                        'Fazendas autônomas e robótica', 'Fertilizantes químicos', 'Arado manual'], correct: 1 },
                { question: 'Em que década a internet começou a conectar fazendas?', options: ['1970', '1980',
                        '2000', '2020'], correct: 2 }
            ];
            let currentQuizIndex = 0;
            const questionText = document.getElementById('questionText');
            const optionsContainer = document.getElementById('optionsContainer');
            const quizFeedback = document.getElementById('quizFeedback');
            const nextQuizBtn = document.getElementById('nextQuizBtn');
            let answered = false;

            function loadQuiz(index) {
                if (index >= quizData.length) {
                    questionText.textContent = 'Parabéns! Você completou o quiz das décadas!';
                    optionsContainer.innerHTML = '';
                    quizFeedback.textContent = 'Obrigado por testar seus conhecimentos sobre a evolução do agro.';
                    nextQuizBtn.style.display = 'none';
                    return;
                }
                const q = quizData[index];
                questionText.textContent = q.question;
                optionsContainer.innerHTML = '';
                q.options.forEach((opt, i) => {
                    const div = document.createElement('div');
                    div.className = 'quiz-option';
                    div.textContent = opt;
                    div.dataset.correct = (i === q.correct) ? 'true' : 'false';
                    div.addEventListener('click', optionClickHandler);
                    optionsContainer.appendChild(div);
                });
                quizFeedback.textContent = '';
                nextQuizBtn.style.display = 'none';
                answered = false;
            }

            function optionClickHandler(e) {
                if (answered) return;
                answered = true;
                const selected = e.target;
                const isCorrect = selected.dataset.correct === 'true';
                // Destacar todas as opções
                document.querySelectorAll('.quiz-option').forEach(opt => {
                    if (opt.dataset.correct === 'true') opt.classList.add('correct');
                    else if (opt === selected && !isCorrect) opt.classList.add('wrong');
                    opt.style.pointerEvents = 'none';
                });
                quizFeedback.textContent = isCorrect ? '✅ Resposta correta!' :
                    '❌ Resposta incorreta. A opção correta está destacada em verde.';
                quizFeedback.style.color = isCorrect ? '#10b981' : '#ef4444';
                if (currentQuizIndex < quizData.length - 1) {
                    nextQuizBtn.style.display = 'inline-block';
                } else {
                    nextQuizBtn.textContent = 'Finalizar Quiz';
                    nextQuizBtn.style.display = 'inline-block';
                }
            }

            nextQuizBtn.addEventListener('click', () => {
                currentQuizIndex++;
                loadQuiz(currentQuizIndex);
                if (currentQuizIndex >= quizData.length) {
                    nextQuizBtn.style.display = 'none';
                }
            });

            loadQuiz(0);

            // === FORMULÁRIO DE CONTATO ===
            document.getElementById('contactForm').addEventListener('submit', function(e) {
                e.preventDefault();
                const inputs = this.querySelectorAll('input, textarea');
                let valid = true;
                inputs.forEach(inp => { if (!inp.value.trim()) valid = false; });
                if (valid) {
                    alert('Mensagem enviada com sucesso! Entraremos em contato em breve.');
                    this.reset();
                } else {
                    alert('Por favor, preencha todos os campos.');
                }
            });

            // === CONTADORES ANIMADOS ===
            const counters = document.querySelectorAll('.counter');
            const counterObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const counter = entry.target;
                        const target = +counter.dataset.target;
                        const duration = 2000;
                        const startTime = performance.now();
                        const startVal = 0;

                        function updateCounter(now) {
                            const elapsed = now - startTime;
                            const progress = Math.min(elapsed / duration, 1);
                            const current = Math.floor(progress * target);
                            counter.textContent = current + (target === 2030 ? '' : '%');
                            if (progress < 1) {
                                requestAnimationFrame(updateCounter);
                            } else {
                                counter.textContent = target + (target === 2030 ? '' : '%');
                            }
                        }
                        requestAnimationFrame(updateCounter);
                        counterObserver.unobserve(counter);
                    }
                });
            }, { threshold: 0.6 });
            counters.forEach(c => counterObserver.observe(c));

            // === ANIMAÇÃO DE ENTRADA (fade) ===
            const fadeElements = document.querySelectorAll('.fade');
            const fadeObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('show');
                        fadeObserver.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.2 });
            fadeElements.forEach(el => fadeObserver.observe(el));

            // === BOTÃO VOLTAR AO TOPO ===
            const backToTop = document.getElementById('backToTop');
            window.addEventListener('scroll', () => {
                if (window.scrollY > 600) {
                    backToTop.classList.add('visible');
                } else {
                    backToTop.classList.remove('visible');
                }
            });
            backToTop.addEventListener('click', () => {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });

            // === PARTÍCULAS DECORATIVAS NO HEADER ===
            const particlesContainer = document.getElementById('particles');
            for (let i = 0; i < 30; i++) {
                const particle = document.createElement('div');
                particle.className = 'particle';
                const size = Math.random() * 8 + 2;
                particle.style.width = size + 'px';
                particle.style.height = size + 'px';
                particle.style.left = Math.random() * 100 + '%';
                particle.style.animationDelay = Math.random() * 8 + 's';
                particle.style.animationDuration = (Math.random() * 8 + 6) + 's';
                particlesContainer.appendChild(particle);
            }

            console.log('🚜 AgroVision 2030 — Experiência interativa das décadas carregada!');
        })();
    </script>
</body>
</html>
